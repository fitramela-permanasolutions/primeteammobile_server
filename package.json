{
  "name": "primeteam-api",
  "version": "1.0.0",
  "description": "RESTful API Backend for PrimeTeam Mobile (CodeIgniter Database Compatible)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"import('fs').then(fs => { fs.mkdirSync('dist/docs', {recursive:true}); fs.copyFileSync('src/docs/openapi.json', 'dist/docs/openapi.json'); })\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.9",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
