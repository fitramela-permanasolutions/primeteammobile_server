# ========================================================
# PRIMETEAM MOBILE SERVER - DOCKER ENVIRONMENT CONFIG
# ========================================================

# Port eksternal untuk API Mobile di Host/VPS
API_PORT=5000

# Kredensial Database MariaDB (sama dengan .env primeteam_original)
# Karena berada dalam docker network yang sama, DB_HOST adalah 'mariadb'
DB_HOST=mariadb
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mariadb_password
DB_NAME=your_mariadb_database
DB_PREFIX=permana_

# Konfigurasi JWT Auth
JWT_SECRET=primeteam_jwt_secret_token_key_permanasolutions_2026
JWT_EXPIRES_IN=7d

# Direktori Upload File di dalam container (ter-mount dari shared volume)
UPLOAD_DIR=/var/www/html/files
MAX_FILE_SIZE_MB=25

# Debug mode (1 = aktifkan logging request & response body)
DEBUG=0

# Nama Docker Network & Volume dari web primeteam_original
# (Default otomatis mengikuti format compose: <nama_folder>_<nama_resource>)
SHARED_NETWORK=primeteam_original_app_network
SHARED_FILES_VOLUME=primeteam_original_app_files
